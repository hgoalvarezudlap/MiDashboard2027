@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LoginLayout";
}

<div class="card w-full max-w-md bg-base-100 shadow-md">
    <div class="card-body gap-4">
        <img src="~/images/logo-udlap.png" alt="UDLAP" width="180" height="38" class="h-auto w-[180px] max-w-full self-start object-contain" asp-append-version="true" />
        <div>
            <h1 class="text-2xl font-bold">Iniciar sesión</h1>
            <p class="mt-1 text-sm text-base-content/70">Entra con tu usuario y contraseña.</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="Login" class="flex flex-col gap-4">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>

            <label class="flex flex-col gap-1">
                <span class="text-sm font-semibold">Usuario</span>
                <input asp-for="Username" autocomplete="username" class="input w-full" />
                <span asp-validation-for="Username" class="text-sm text-error"></span>
            </label>

            <label class="flex flex-col gap-1">
                <span class="text-sm font-semibold">Contraseña</span>
                <input asp-for="Password" autocomplete="current-password" class="input w-full" />
                <span asp-validation-for="Password" class="text-sm text-error"></span>
            </label>

            <button type="submit" class="btn btn-primary">Entrar</button>
        </form>
    </div>
</div>
